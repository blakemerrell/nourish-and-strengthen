rules_version = '2';

/*
 * Who may touch a household record.
 *
 * The app signs every visitor in anonymously and on purpose — that is how two
 * phones share a plan without either of you making an account. So
 * `request.auth != null` is true for every person who opens the page, and is
 * not a gate on its own. The household code is the secret.
 *
 * Which is why `read` is wrong here. It is two permissions sharing one name:
 *
 *   get   fetch the one household whose code you typed. The app does this,
 *         and does nothing else — src/sync.js asks for a single document by
 *         its code and never queries the collection.
 *   list  hand back every household there is. Nothing in the app has ever
 *         wanted this, and granting it gives away the whole premise: a code
 *         stops being a secret the moment the codes can be enumerated.
 *
 * Verified against the live project on 2026-08-09 while `read` was still in
 * force: an anonymous sign-in followed by a list returned real documents.
 *
 * delete is off for the same reason it is never used. Nothing in the app
 * removes a household, so nothing should be able to.
 */
/*
 * And who may touch a person's own record.
 *
 * The household above is shared on purpose: a meal plan and a grocery list,
 * handed to a spouse by reading them a code. My Day is not that. It holds a
 * weight history and what somebody eats, and it went out to a congregation,
 * from where it goes anywhere — so it is not guarded by a secret that can be
 * read aloud, forwarded, or guessed. It is guarded by whose it is.
 *
 * request.auth.uid == uid is the whole rule. Every visitor is still signed in
 * anonymously and can still use the entire app on their own device without an
 * account; signing in with Google or an email link only turns an anonymous
 * identity into one that can be reached from a second device. Nobody else's
 * uid matches, so nobody else's request does.
 *
 * list stays off here for the same reason it is off above.
 */
/*
 * What a household document may become, and who may change who is in it.
 *
 * The code is still the key — the owner chose to keep codes that can be read
 * aloud across a kitchen — so anybody who has heard one can still get in.
 * What these rules take away is what such a person could do once there:
 *
 *   Wipe it in one write. A document written as {} (a set without merge),
 *   or with its recipes or weeks replaced by an empty map, took every
 *   recipe anyone had written with it, on every phone, because each phone
 *   mirrors the document. A write now keeps every field the document has,
 *   and may take away at most one week, one recipe, one edit, one favourite
 *   and one pantry item at a time — which is all the app ever does. Somebody
 *   determined can still remove things one by one; every phone keeps what
 *   was taken (see keepRemoved in src/sync.js) and can put it back.
 *
 *   What is NOT stopped, said plainly (the back-end review of 4 October
 *   proved each on the emulator): a write that keeps every key and changes
 *   what is under it — every recipe emptied, every week's plan cleared, the
 *   ratings and the kitchen set to {} — and lists or maps filled to their
 *   caps with keys the app ignores. Asking that of every map costs more than
 *   Firestore allows a request (see "Room to spare" in
 *   tests/rules/rules.check.js), so against somebody who has the code and
 *   means harm, the protection is a backup of the database, not these rules.
 *
 *   Throw other people out. The members list may only change by the person
 *   writing adding or removing themselves, and nobody may be on it twice.
 *
 *   Fill it with anything. Only the fields the app has ever written are
 *   allowed, each with its type, and none of the lists or maps may grow
 *   past a size no household reaches; the two plain strings are capped.
 *
 * myday is the one field that may leave: it is what the old private-code
 * My Day wrote into this collection, and clearing it is the clean-up.
 */
/*
 * And a dinner's numbers, each person's own.
 *
 * Plan my week asks whether a dinner fits a Nourish plan, and a household
 * has more than one plan in it: Blake's wife would set hers up and share it.
 * The plan itself lives in each person's own record, above, and stays
 * there. What comes into the household is one entry under `diners`, keyed
 * by the account it belongs to: a name to call it by, and a dinner's
 * calories and protein. Not the weight, not the day, not the targets.
 *
 * So the one thing to hold is that a person writes only their own. The code
 * still lets anybody in, and what they could otherwise do is put words in
 * somebody else's name, or take a person's numbers away, on every phone in
 * the household. A write may change no key of `diners` but the writer's own
 * uid, and that entry has to be the three things the app writes and nothing
 * more: a name of up to 30 characters, and two numbers in a range a dinner
 * can be. Twenty of them is more people than sit at any table.
 */
service cloud.firestore {
  match /databases/{database}/documents {

    function houseFields() {
      return ['favs', 'weeks', 'active', 'mine', 'edits', 'pantry', 'pantryNew',
        'kitchen', 'src', 'rate', 'opts', 'low', 'members', 'lastInvite',
        'plan', 'checked', 'myday', 'diners'];
    }

    function mapOf(d, k, most) { return !(k in d) || (d[k] is map && d[k].size() <= most); }

    function houseShape(d) {
      return d.keys().hasOnly(houseFields())
        && (!('favs' in d) || (d.favs is list && d.favs.size() <= 2000))
        && mapOf(d, 'weeks', 300) && mapOf(d, 'mine', 2000) && mapOf(d, 'edits', 1000)
        && mapOf(d, 'pantry', 2000) && mapOf(d, 'pantryNew', 1000)
        && mapOf(d, 'kitchen', 2000) && mapOf(d, 'src', 2000) && mapOf(d, 'rate', 2000)
        && mapOf(d, 'opts', 100) && mapOf(d, 'low', 2000)
        && mapOf(d, 'plan', 50) && mapOf(d, 'checked', 2000) && mapOf(d, 'myday', 50)
        && mapOf(d, 'diners', 20)
        && (!('active' in d) || (d.active is string && d.active.size() <= 64))
        && (!('members' in d) || (d.members is list && d.members.size() <= 50))
        && (!('lastInvite' in d) || (d.lastInvite is string && d.lastInvite.size() <= 64));
    }

    // at most one gone per write, which is as fast as the app ever removes one
    function shrinksByOne(k) {
      return !(k in resource.data)
        || request.resource.data[k].size() >= resource.data[k].size() - 1;
    }

    function keepsWhatItHas() {
      return request.resource.data.keys().hasAll(resource.data.keys().removeAll(['myday']))
        && shrinksByOne('weeks') && shrinksByOne('mine') && shrinksByOne('edits')
        && shrinksByOne('favs') && shrinksByOne('pantryNew');
    }

    /* An account, not a browser's throwaway identity. Anonymous sign-ins
       live and die with one browser, and the app never lists one (enrol in
       src/sync.js) or shares a plan under one; but with the code, fifty of
       them could be made and put on the list, and the list is capped at
       fifty and nobody may take another's entry off it. Then no account
       could ever join. */
    function named() {
      return request.auth.token.get('firebase', {}).get('sign_in_provider', '') != 'anonymous';
    }

    /* Compared as sets, a list padded with copies of who was already on it
       came out "unchanged", needed no account, and filled the fifty places
       with nobody new: then no account could ever join. A list that changes
       at all must be the writer's account adding or taking off itself, with
       nobody on it twice. */
    function membersByThemselves() {
      let was = resource.data.get('members', []);
      let now = request.resource.data.get('members', []);
      let before = was.toSet();
      let after = now.toSet();
      let me = [request.auth.uid].toSet();
      return now == was || (named() && now.size() == after.size()
        && (after == before.union(me) || after == before.difference(me)));
    }

    // a name, and a dinner's calories and protein: what setMyDiner in src/sync.js writes
    function dinerOk(e) {
      return e is map && e.keys().hasOnly(['n', 'kc', 'p']) && e.keys().hasAll(['n', 'kc', 'p'])
        && e.n is string && e.n.size() >= 1 && e.n.size() <= 30
        && e.kc is int && e.kc >= 150 && e.kc <= 3000
        && e.p is int && e.p >= 0 && e.p <= 400;
    }

    // whatever diners the writer leaves behind them, their own is one the app could have written
    function ownDinerOk(d) {
      return !(request.auth.uid in d) || dinerOk(d[request.auth.uid]);
    }

    /* Only the writer's own entry changes, and only an account changes one.
       An entry already there is not re-judged by a write that leaves it be:
       one written under looser rules must not stop every later write. */
    function dinersByThemselves() {
      let after = request.resource.data.get('diners', {});
      let changed = after.diff(resource.data.get('diners', {})).affectedKeys();
      return changed.size() == 0
        || (named() && changed.hasOnly([request.auth.uid]) && ownDinerOk(after));
    }

    match /households/{code} {
      allow get: if request.auth != null;
      allow create: if request.auth != null
        && houseShape(request.resource.data)
        && request.resource.data.get('members', []).toSet()
          .difference([request.auth.uid].toSet()).size() == 0
        && request.resource.data.get('diners', {}).keys().hasOnly([request.auth.uid])
        && ownDinerOk(request.resource.data.get('diners', {}))
        && (named() || (request.resource.data.get('members', []).size() == 0
          && request.resource.data.get('diners', {}).size() == 0));
      allow update: if request.auth != null
        && houseShape(request.resource.data)
        && keepsWhatItHas()
        && membersByThemselves()
        && dinersByThemselves();
      allow list, delete: if false;
    }

    match /users/{uid} {
      allow get, create, update, delete: if request.auth != null && request.auth.uid == uid;
      allow list: if false;
    }

    /*
     * Strengthen's workouts, one record per calendar year under your own
     * (users/{uid}/train/2026). A single record holds a megabyte, and a year
     * of training is about a third of one, so one record for everything
     * filled in about three years. By year, there is no ceiling.
     *
     * Guarded exactly as your own record is: by whose it is. list is on here,
     * where the one above has it off, because the app reads your years as a
     * set and deleting your account has to find every one of them — and a
     * list under /users/{uid}/train can only ever be of your own uid's, since
     * the uid in the path has to be yours. It grants no way to list anybody
     * else's, or the users collection itself.
     */
    match /users/{uid}/train/{year} {
      allow get, list, delete: if request.auth != null && request.auth.uid == uid;
      // a year, as yearOf in src/train.js names one: not any name at all, each a megabyte
      allow create, update: if request.auth != null && request.auth.uid == uid
        && year.matches('^[0-9]{4}$');
    }

    /*
     * An invite: one person into one household, once, within a week.
     *
     * Made only by somebody already on that household's members list, naming
     * themselves as the maker, unspent. Spent only by flipping `used` to true
     * and recording who spent it — nothing else about it can change, so an
     * invite cannot be re-aimed at another household or brought back to life.
     * The token is the document id and is never listed, so an invite is found
     * only by holding its link.
     *
     * Readable only while it can still be used. It was readable forever, and
     * it names the household — so a link forwarded once, and spent, went on
     * handing the household's code to whoever found it in an old message. A
     * link that never existed still reads as missing, which the app says in
     * words of its own.
     *
     * And it has to run out. `exp` was only checked to be a number, so an
     * invite could be made to last forever; now it is at most eight days out
     * (a week, and a day of slack for a phone whose clock is fast).
     */
    match /invites/{token} {
      allow get: if request.auth != null
        && (resource == null
          || (resource.data.used == false && resource.data.exp > request.time.toMillis()));
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['house', 'by', 'made', 'exp', 'used'])
        && request.resource.data.by == request.auth.uid
        && request.resource.data.used == false
        && request.resource.data.house is string
        && request.resource.data.exp is int
        && request.resource.data.exp > request.time.toMillis()
        && request.resource.data.exp <= request.time.toMillis() + 8 * 86400000
        && request.auth.uid in get(/databases/$(database)/documents/households/$(request.resource.data.house)).data.get('members', []);
      allow update: if request.auth != null
        && named()
        && resource.data.used == false
        && resource.data.exp > request.time.toMillis()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['used', 'usedBy'])
        && request.resource.data.used == true
        && request.resource.data.usedBy == request.auth.uid;
      allow list, delete: if false;
    }
  }
}
