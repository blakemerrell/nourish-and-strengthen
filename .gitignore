node_modules/
# print/ IS committed. The app links to those files so that "download the book"
# is one click at the right size, rather than a negotiation with the print
# dialog. Run `npm run print` after changing a recipe or the food table, and
# tests/print.test.js will tell you if you forgot.
art/contact-sheet.png

# The Firestore emulator the rules check downloads (tests/rules/rules.check.js).
.emulator/

# The built site: tools/build-site.js writes it and the deploy publishes it.
# It is never committed — the version it carries is computed, not kept.
_site/

